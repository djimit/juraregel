// Classificatie zaak-intake — smalle, fail-closed pilot
// Bron: Wetboek van Burgerlijke Rechtsvordering, artikel 93

regel CL-2026-001 "Geldvordering tot en met 25.000 euro — kanton":
  als vorderingType is geldvordering en vorderingWaarde is ten hoogste €25.000 en bijzondereCategorie is geen
  dan is zaakstroom kanton.

regel CL-2026-002 "Vordering van onbepaalde waarde — handmatige kwalificatie":
  als vorderingType is onbepaalde_waarde
  dan is handmatige controle vereist.

regel CL-2026-003 "Geldvordering boven 25.000 euro — buiten smalle pilot":
  als vorderingType is geldvordering en vorderingWaarde is meer dan €25.000 en bijzondereCategorie is geen
  dan is handmatige controle vereist.
